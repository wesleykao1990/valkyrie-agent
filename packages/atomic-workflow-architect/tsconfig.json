{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": [],
    "typeRoots": ["./test-stubs", "./node_modules/@types"]
  },
  "include": [
    "extensions/**/*.ts",
    "workflows/**/*.ts",
    "lib/**/*.d.ts",
    "test-stubs/**/*.d.ts"
  ]
}
