PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
PROJECT_BRAIN_DIR=./project-brain
DEMO_STAGE_DELAY_MS=1200
CONTROL_PLANE_API=http://127.0.0.1:8787
DEFAULT_RUNTIME=atomic
# Used only by the Atomic JSONL RPC client scaffold until the real adapter is wired.
ATOMIC_COMMAND=atomic
OPENVIKING_MODE=disabled
# OPENVIKING_URL=http://127.0.0.1:1933
# The real Atomic RPC scaffold inherits only basic OS variables. Add provider
# variable names explicitly for a disposable worker; do not expose a full shell.
ATOMIC_RUNTIME_ENV_ALLOWLIST=
