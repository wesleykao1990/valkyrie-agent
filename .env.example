PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
PROJECT_BRAIN_DIR=./project-brain
DEMO_STAGE_DELAY_MS=1200
CONTROL_PLANE_API=http://127.0.0.1:8787
# Reserved for future default selection. Current runs use an explicit runtime or
# the routing policy; changing this value does not currently alter routing.
DEFAULT_RUNTIME=atomic

# Storage defaults to the zero-service SQLite demo adapter. PostgreSQL is
# opt-in and fails closed when DATABASE_URL or migration state is invalid.
CONTROL_PLANE_STORE=sqlite
# DATABASE_URL=postgresql://control_plane:replace-me@127.0.0.1:5432/control_plane
POSTGRES_AUTO_MIGRATE=false
SEED_DEMO_DATA=true
ENABLE_DEMO_RESET=true
# Both demo flags are hard-disabled whenever CONTROL_PLANE_STORE=postgres,
# even if a copied local environment leaves them set to true.

# Used only by the Atomic JSONL RPC client scaffold until the real adapter is wired.
ATOMIC_COMMAND=atomic
OPENVIKING_MODE=disabled
# OPENVIKING_URL=http://127.0.0.1:1933
# The real Atomic RPC scaffold inherits only basic OS variables. Add provider
# variable names explicitly for a disposable worker; do not expose a full shell.
ATOMIC_RUNTIME_ENV_ALLOWLIST=
