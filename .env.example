# The application does not load this file automatically. Export selected values
# or set them for one command. Never put real secrets in a committed copy.

HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
PROJECT_BRAIN_DIR=./project-brain
DEMO_STAGE_DELAY_MS=1200
CONTROL_PLANE_API=http://127.0.0.1:8787

# Set exactly one token source. Native adapters and non-loopback HOST require it.
# npm run setup:pilot creates the ignored 0600 file below.
# CONTROL_PLANE_AUTH_TOKEN_FILE=./data/auth/control-plane.token
# CONTROL_PLANE_AUTH_TOKEN=replace-with-at-least-32-non-whitespace-characters

# Defaults remain mocks. bin/project-os-pilot-server sets these to native.
ATOMIC_ADAPTER=mock
CODEX_ADAPTER=mock
CLAUDE_ADAPTER=mock

ATOMIC_COMMAND=atomic
ATOMIC_EXPECTED_VERSION=0.9.12
ATOMIC_PACKAGE_DIR=./packages/atomic-workflow-architect
# Offline Atomic discovery intentionally inherits no configured provider secrets.
ATOMIC_RUNTIME_ENV_ALLOWLIST=

CODEX_COMMAND=codex
CODEX_EXPECTED_VERSION=0.147.0-alpha.6.5
CODEX_RUNTIME_ENV_ALLOWLIST=

CLAUDE_COMMAND=claude
CLAUDE_EXPECTED_VERSION=2.1.81
# For the opt-in bare Claude probe, set this to ANTHROPIC_API_KEY and inject the
# actual key from a password manager into the server shell.
CLAUDE_RUNTIME_ENV_ALLOWLIST=

# Credential-free Milestone 5a fixture integration. This remains false by
# default and is independent of ATOMIC_ADAPTER=native (the M3 connectivity
# adapter). When true, bearer auth, absolute repository/engine/root paths, and an
# immutable image digest are required; the local Unix socket and numeric user are
# optional reviewed overrides.
# It accepts only project atomic-pilot, task task_atomic_fixture_m5, the literal
# published objective, and workflow atomic-fixture-pilot. It has network none and
# receives no provider/model credential.
ATOMIC_FIXTURE_PILOT_ENABLED=false
# ATOMIC_FIXTURE_PILOT_REPOSITORY=/absolute/engine-visible/path/to/disposable-fixture
# ATOMIC_FIXTURE_PILOT_ENGINE=/absolute/path/to/docker
# ATOMIC_FIXTURE_PILOT_ENGINE_SOCKET=unix:///absolute/path/to/docker.sock
# ATOMIC_FIXTURE_PILOT_IMAGE=localhost:5000/valkyrie-atomic-runner@sha256:<64-hex-digest>
# ATOMIC_FIXTURE_PILOT_ROOT=/absolute/engine-visible/private/pilot-root
# Optional reviewed numeric non-root owner when host derivation is unsuitable.
# ATOMIC_FIXTURE_PILOT_USER=501:20
ATOMIC_FIXTURE_PILOT_MAX_COST_USD=1

# Milestone 5b remains disabled until the model boundary is explicitly selected.
# `codex-subscription` uses a dedicated Codex profile logged in with ChatGPT; it
# does not need an OpenAI API key. `openai-compatible` uses the URL/credential
# fields below. In both modes the writer receives only an expiring Valkyrie
# capability and never the provider/subscription credential.
ATOMIC_FIXTURE_MODEL_PILOT_ENABLED=false
# Authenticated actor ID recorded on model-pilot cancel/final-acceptance events.
# CONTROL_PLANE_OPERATOR_ID=wesley-local-operator
# ATOMIC_FIXTURE_MODEL_UPSTREAM_MODE=codex-subscription
# ATOMIC_FIXTURE_MODEL_PROVIDER=openai-codex-subscription
# ATOMIC_FIXTURE_MODEL_ID=gpt-5.6-sol
# ATOMIC_FIXTURE_MODEL_CODEX_COMMAND=/opt/homebrew/bin/codex
# ATOMIC_FIXTURE_MODEL_CODEX_EXPECTED_VERSION=0.147.0
# ATOMIC_FIXTURE_MODEL_CODEX_HOME=/absolute/private/path/codex-subscription-profile
# ATOMIC_FIXTURE_MODEL_CODEX_SCRATCH_ROOT=/absolute/private/path/codex-subscription-scratch
# ATOMIC_FIXTURE_MODEL_CODEX_OUTPUT_SCHEMA=/absolute/repo/path/apps/control-plane/schemas/codex-subscription-broker-output.schema.json
ATOMIC_FIXTURE_MODEL_CODEX_REASONING_EFFORT=medium
# OpenAI-compatible mode only:
# ATOMIC_FIXTURE_MODEL_PROVIDER=openai
# ATOMIC_FIXTURE_MODEL_ID=reviewed-api-model-id
# ATOMIC_FIXTURE_MODEL_UPSTREAM_BASE_URL=https://api.provider.example/v1
# ATOMIC_FIXTURE_MODEL_CREDENTIAL_FILE=/absolute/private/path/provider.token
ATOMIC_FIXTURE_MODEL_CREDENTIAL_HEADER=bearer
ATOMIC_FIXTURE_MODEL_ALLOW_CREDENTIAL_FREE_LOOPBACK=false
ATOMIC_FIXTURE_MODEL_GATEWAY_PORT=8790
# Dedicated Docker bridge proven Internal=true; never reuse a general egress network.
# ATOMIC_FIXTURE_MODEL_NETWORK=valkyrie-model-pilot
# ATOMIC_FIXTURE_MODEL_ACCEPTED_PACKAGE_SHA256=<64-hex-package-digest>
# ATOMIC_FIXTURE_MODEL_ACCEPTED_IMAGE_DIGEST=sha256:<64-hex-image-digest>
# Subscription defaults are 256000/32000; external API defaults are 32000/8000.
# These are aggregate across at most 16 native tool-loop requests.
# ATOMIC_FIXTURE_MODEL_MAX_INPUT_TOKENS=256000
# ATOMIC_FIXTURE_MODEL_MAX_OUTPUT_TOKENS=32000
ATOMIC_FIXTURE_MODEL_MAX_COST_USD=1
# Required for an external provider. Values are micro-USD per million tokens.
ATOMIC_FIXTURE_MODEL_INPUT_COST_MICROS_PER_MILLION=0
ATOMIC_FIXTURE_MODEL_OUTPUT_COST_MICROS_PER_MILLION=0

# Milestone 6 direct candidates. Codex reuses the reviewed host-side scoped
# broker but owns a separate root run/worktree/container/lease. Claude Code is
# intentionally unavailable until its separate credential boundary is verified.
DIRECT_CODEX_MODEL_PILOT_ENABLED=false
DIRECT_CLAUDE_MODEL_PILOT_ENABLED=false

# Unset means every MCP tool; the pilot wrapper supplies a restricted subset.
# CONTROL_PLANE_MCP_TOOL_ALLOWLIST=projects_list,runtimes_status

# SQLite is the zero-service default. PostgreSQL is opt-in and fails closed.
CONTROL_PLANE_STORE=sqlite
# DATABASE_URL=postgresql://control_plane:replace-me@127.0.0.1:5432/control_plane
POSTGRES_AUTO_MIGRATE=false
SEED_DEMO_DATA=true
ENABLE_DEMO_RESET=true

# Reserved for routing/configuration compatibility; current explicit requests and
# policy choose the runtime.
DEFAULT_RUNTIME=atomic

OPENVIKING_MODE=disabled
# OPENVIKING_URL=http://127.0.0.1:1933

# REPOSITORY_PATH_OVALO=/absolute/path/to/a-disposable/repository
