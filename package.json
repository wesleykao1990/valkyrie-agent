{
  "name": "wesley-agent-control-plane-prototype",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local-first prototype of a Hermes-fronted, Linear-backed multi-agent control plane.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types apps/control-plane/src/index.ts",
    "dev": "node --watch --experimental-strip-types apps/control-plane/src/index.ts",
    "mcp": "node --experimental-strip-types apps/mcp-server/src/index.ts",
    "typecheck": "tsc --noEmit --noCheck false",
    "test": "node --experimental-strip-types scripts/test-unit.ts",
    "test:postgres": "node --experimental-strip-types scripts/test-postgres-storage.ts",
    "migrate": "node --experimental-strip-types scripts/migrate-storage.ts",
    "verify:atomic": "npm --prefix packages/atomic-workflow-architect run verify:all",
    "reset": "node --experimental-strip-types scripts/reset-demo.ts",
    "setup:atomic": "npm install --ignore-scripts --no-save --prefix data/runtime/atomic @bastani/atomic@0.9.12",
    "setup:atomic-fixture": "node --experimental-strip-types scripts/setup-atomic-fixture.ts",
    "setup:codex-subscription": "node --experimental-strip-types scripts/setup-codex-subscription-profile.ts",
    "setup:pilot": "node --experimental-strip-types scripts/setup-local-pilot.ts",
    "setup:hermes": "node --experimental-strip-types scripts/setup-hermes-profile.ts",
    "skills:manage": "node --experimental-strip-types scripts/manage-skill-suite.ts",
    "mcp:quiet": "node --experimental-strip-types apps/mcp-server/src/index.ts",
    "smoke:mcp": "node --experimental-strip-types scripts/mcp-smoke.ts",
    "smoke:native": "node --experimental-strip-types scripts/live-native-smoke.ts",
    "smoke:atomic-fixture": "node --experimental-strip-types scripts/atomic-fixture-live-smoke.ts",
    "smoke:atomic-model": "node --experimental-strip-types scripts/atomic-model-pilot-live-smoke.ts",
    "smoke:m6-comparison": "node --experimental-strip-types scripts/direct-model-comparison-live-smoke.ts",
    "smoke:m7-read": "node --experimental-strip-types scripts/m7-live-read-smoke.ts",
    "smoke:codex-subscription": "node --experimental-strip-types scripts/codex-subscription-smoke.ts",
    "smoke:sandbox": "node --experimental-strip-types --test --test-name-pattern=live.Docker-compatible.sandbox tests/oci-sandbox-provider.test.ts",
    "verify": "npm run typecheck && npm test && npm run test:postgres && npm run verify:atomic && npm run smoke:http && npm run smoke:mcp",
    "smoke:http": "node --experimental-strip-types scripts/http-smoke.ts"
  },
  "optionalDependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
