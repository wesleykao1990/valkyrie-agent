{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noCheck": true,
    "outDir": "dist"
  },
  "include": ["apps/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
